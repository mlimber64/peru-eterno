<?xml version="1.0" encoding="utf-8"?>
<!--
  Equivalente de data_extraction_rules.xml para Android 6 a 11 (API 23-30),
  que no entienden el formato nuevo. Ahí no existe la distinción entre respaldo
  en la nube y transferencia directa, así que se excluye todo.

  Ver data_extraction_rules.xml para el motivo completo.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
